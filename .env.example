# ---- Server ----
PORT=3000

# A random long string used to sign rating links. Change this to anything random.
SECRET=change-this-to-a-random-string

# The password you (the admin/editor) will type into /admin.html to manage the queue.
ADMIN_PASSWORD=Sinan@7829

# ---- Email (sent FROM your own mail id) ----
# Uses Gmail with an "App Password" (not your normal password).
# 1. Turn on 2-Step Verification on your Google account.
# 2. Go to https://myaccount.google.com/apppasswords and create an app password.
# 3. Put your gmail address and the 16-character app password below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mohdsinan707@gmail.com
SMTP_PASS=your-16-char-app-password
FROM_NAME=Editing Universe

# Public URL of your deployed app (used to build the rating link inside emails).
# When testing locally this is fine as-is. Update once deployed.
APP_URL=https://video-queue-app.vercel.app

# Average turnaround per video in hours, used to estimate wait time shown to requesters.
AVG_TURNAROUND_HOURS=24
